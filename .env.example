# YVC product application — environment template.
#
# Copy to .env.local and fill in. Never commit .env.local.
# Never prefix a secret with NEXT_PUBLIC_: Next.js inlines those into the
# browser bundle. An end-to-end test asserts the server-only names below are
# absent from client JavaScript.

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
# Origin for all backend traffic. Server-only. No trailing slash.
# There is no YVC backend yet — see docs/api/API_CONTRACT.md. Leave blank for
# local work and enable sample data below.
YVC_API_BASE_URL=

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Encrypts the session cookie (JWE, A256GCM). At least 32 characters.
#   openssl rand -base64 48
# Rotating this signs every user out. Unset means authentication is disabled;
# the sign-in page says so rather than showing a button that cannot work.
YVC_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Development and test only
# ---------------------------------------------------------------------------
# "true" serves built-in SAMPLE opportunities when no API origin is set, so the
# UI and the test suites have something to run against. Fictional data only;
# the interface displays a visible notice whenever it is active.
# MUST be absent or false in production.
YVC_ENABLE_SAMPLE_DATA=true

# ---------------------------------------------------------------------------
# Public
# ---------------------------------------------------------------------------
# Canonical origin for metadata, canonical URLs, hreflang, and the sitemap.
NEXT_PUBLIC_SITE_ORIGIN=http://localhost:3000
