# Every NEXT_PUBLIC_* value is embedded in the browser bundle. Never put a
# secret here, and keep real local values in .env.local (which is not tracked).
#
# Both values are optional and blank on purpose: no application origin or
# marketing domain is verified for Volontyorlar yet. The interface degrades
# honestly when one is missing rather than guessing.

# Canonical origin of this application, e.g. https://app.example.org — origin
# only, no path. It feeds metadataBase and the transport-only security headers.
NEXT_PUBLIC_SITE_URL=

# Origin of the public marketing site. While it is empty the "about", privacy
# and terms links are not rendered at all; put a local placeholder such as
# http://localhost:3000 in .env.local to work on them.
NEXT_PUBLIC_MARKETING_URL=

# ---------------------------------------------------------------------------
# Sign-in. Both values are server-only: never give either a NEXT_PUBLIC_
# prefix, and never read them from a Client Component. While either is blank
# no one can sign in: every volunteer route redirects to /login and the
# Telegram button reports that sign-in is unavailable.
# ---------------------------------------------------------------------------

# Origin of v-backend, e.g. http://localhost:4000 in development.
VOLONTYORLAR_API_URL=

# Key for the encrypted session cookie. At least 32 characters; generate one
# with: openssl rand -base64 48
VOLONTYORLAR_SESSION_SECRET=
